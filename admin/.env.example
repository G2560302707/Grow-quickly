# 管理端环境变量模板：复制为 admin/.env 后按需修改
# 会话密钥需与学习端 .env 的 NEXTAUTH_SECRET 保持一致（两端各自签发自己的 cookie）
NEXTAUTH_SECRET="change-me-in-production"

# 共享配置文件：默认指向仓库根目录的 config/app-config.json（相对 admin 运行目录）
# Docker 中由 compose 设置为 /app/config/app-config.json
APP_CONFIG_PATH="../config/app-config.json"

# 日志级别: trace, debug, info, warn, error, fatal
LOG_LEVEL="info"
