# Docker 构建时排除的文件
Dockerfile
.dockerignore
docker-compose*.yml

# 依赖和构建产物
node_modules
npm-debug.log
.next
dist

# 版本控制
.git
.gitignore

# 环境配置
.env
.env.*

# 单元/集成测试文件
src/__tests__
vitest.config.ts
coverage

# E2E 测试文件 (Playwright)
e2e
playwright.config.ts
playwright-report
test-results
blob-report
test_output*.txt

# 开发工具
.vscode
.idea
*.log
.github
*.tsbuildinfo

# 本地数据库
*.db
*.db-journal
*.sqlite
*.sqlite-journal
/prisma/*.db

# 文档
README.md
docs
doc

# 本地数据与证书（运行时通过卷挂载，绝不打入镜像）
data
certs
*.pem

# 应用配置文件（含 AI 密钥/SMTP，运行时通过卷挂载或管理端首次配置）
config

# 各工作区/子项目的本地依赖（防止覆盖容器内按 Linux 平台安装的依赖）
**/node_modules

# uniapp 构建产物
uniapp/dist
