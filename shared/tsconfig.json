{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "esnext"],
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
