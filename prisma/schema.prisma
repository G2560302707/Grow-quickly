// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  focusDailyGoalMin Int @default(120) // 专注每日目标(分钟)，小程序番茄钟跨端同步

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  practiceQuestions PracticeQuestion[]
  focusSessions  FocusSession[]
  customTags KnowledgeTag[] // User's custom tags
  feedbacks  Feedback[] // 用户提交的反馈（移动端帮助与反馈页）
  announcementReads AnnouncementRead[] // 公告已读记录
}

// 系统公告（管理员在设置弹窗"公告管理"发布，网页端铃铛与小程序首页展示）
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true) // 下架后不再对用户展示，仅管理员可见
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads AnnouncementRead[]
}

// 公告已读：用户维度记录，红点只对未读公告亮
model AnnouncementRead {
  id            String      @id @default(cuid())
  announcementId String
  announcement  Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt        DateTime    @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

// 用户反馈（移动端"帮助与反馈"提交；网页端暂无管理界面，可通过 API/数据库查看）
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   @default("other") // feature: 功能建议 / bug: 问题反馈 / other: 其他
  content   String
  contact   String?  // 可选联系方式（邮箱/微信等）
  status    String   @default("open") // open: 待处理 / resolved: 已处理

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  // 全局题库题的主考点关联
  bankQuestions BankQuestion[] @relation("BankPrimaryTag")

  // 已归因的定向练习
  practiceRecords PracticeRecord[]
  practiceQuestions PracticeQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  iconKey   String  @default("other") // 图标键（notebook-icons 资源名），创建/编辑时选择
  isDefault Boolean @default(false) // 默认本，每用户至多一个；删除其它本时题目迁入此处

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  explanationSource String? // 解析来源: ai(AI 生成) / ocr(用户上传解析图转录)；空值为历史数据
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  origin           String? // 题目进入错题本的渠道: similar(举一反三练习) / smart(薄弱点专项练习)；拍照或手动录入为 null
  sourceType       String? // 数据大类: manual(拍照/手动录入的真错题) / practice(练习答错自动收录)；空值为历史数据
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
  practiceRecords PracticeRecord[] // 锚定本题的定向练习
  practiceQuestions PracticeQuestion[] // 锚定本题的待做/已做练习题

  @@index([userId, createdAt])
  @@index([subjectId])
  @@index([userId, masteryLevel])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())

  @@index([errorItemId])
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  
  // 定向练习归因（可空：旧数据与网页端调用不传则保持为空）
  errorItemId String? // 本次练习锚定的原错题
  errorItem   ErrorItem? @relation(fields: [errorItemId], references: [id], onDelete: SetNull)
  tagId       String? // 本次练习归属的知识点（薄弱点诊断的练习通道）
  tag         KnowledgeTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)
  channel     String? // 练习渠道: free(自由练习) / similar(举一反三) / smart(薄弱点专项)；历史数据由迁移回填
  questionId  String? // 本次作答对应的练习题库题目
  question    PracticeQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionText String? // 生成题快照（用于出题去重）
  answerText String? // 参考答案快照（练习记录详情展示）
  analysis  String? // 解析快照（练习记录详情展示）

  createdAt DateTime @default(now())

  @@index([userId, tagId])
  @@index([userId, createdAt])
}

// 练习题库：AI 生成的每一道练习题生成即入库，做不做都保留（待做/已做/已弃）
model PracticeQuestion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel     String   // free(自由练习) | similar(举一反三) | smart(薄弱点专项) | bank(题库抽题)
  difficulty  String   // easy | medium | hard | harder
  subject     String?

  // 归因：薄弱点专项挂考点，举一反三锚定原错题，题库抽题挂全局题库题
  tagId       String?
  tag         KnowledgeTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)
  errorItemId String?
  errorItem   ErrorItem?    @relation(fields: [errorItemId], references: [id], onDelete: SetNull)
  bankQuestionId String?
  bankQuestion   BankQuestion? @relation(fields: [bankQuestionId], references: [id], onDelete: SetNull)

  // 题目快照：生成时全量落库
  questionText String
  answerText  String?
  analysis    String?
  eloRating   Int?     // 生成时该考点的能力分（smart 渠道）

  // 生命周期：pending(待做) -> answered(已做) / discarded(已弃，可恢复)
  status      String   @default("pending")
  isCorrect   Boolean? // 作答结果（冗余，题库内直接可统计）
  answeredAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  practiceRecords PracticeRecord[] // 本题的作答流水

  @@index([userId, status])
  @@index([userId, channel, status])
  @@index([userId, tagId, status])
  @@index([userId, difficulty, status])
}

// 专注会话(番茄钟/模考掐表)
model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode      String   // pomodoro(番茄钟) | mock(整卷模考) | custom(自定义)
  moduleName String? // 绑定的行测模块(言语理解等),可空
  targetSeconds   Int // 计划时长
  durationSeconds Int // 实际专注秒数
  completed Boolean  // 是否完整走完(未中途放弃)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 全局题库：管理员离线导入的题目资产，所有用户共享（与用户维度的 PracticeQuestion 分离）。
// 生命周期：raw(已切分待解析) -> pending(解析完成待审) -> published(可被抽题) / disabled(下架)
model BankQuestion {
  id            String  @id @default(cuid())
  subject       String  @default("")        // 行测模块：言语理解/判断推理/数量关系/资料分析/常识判断（raw 切片解析前为空）
  primaryTagId  String?
  primaryTag    KnowledgeTag? @relation("BankPrimaryTag", fields: [primaryTagId], references: [id], onDelete: SetNull)
  extraTagIds   String?             // JSON 数组：辅助考点标签 id
  difficulty    String  @default("medium") // easy | medium | hard | harder
  questionType  String  @default("single") // single 单选 | multiple 多选 | subjective 主观
  questionText  String  @default("")
  rawText       String?             // 解析前的原始切片文本（raw 状态题以此为解析输入）
  answerText    String?
  analysis      String?
  requiresImage Boolean @default(false) // 图形/图表题，纯文本题库默认不参与抽题
  source        String?             // 来源（文件名/出处），留痕
  status        String  @default("raw")
  contentHash   String?             // 题干归一化 sha1，唯一约束挡精确重复
  duplicateOf   String?             // bigram 命中的疑似重复题 id（审核时人工裁决）
  confidence    String?             // 解析置信度：high | medium | low
  importBatchId String?
  importBatch   BankImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  attemptCount  Int @default(0)     // 动态难度校准统计
  correctCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practiceQuestions PracticeQuestion[]

  @@unique([contentHash])
  @@index([status, subject, difficulty])
  @@index([primaryTagId, status])
  @@index([importBatchId])
}

// 题库导入批次：记录一次导入的原文与解析进度（分批推进可续跑）
model BankImportBatch {
  id String @id @default(cuid())
  name String              // 文件名或"粘贴导入"
  source String?           // 来源出处备注
  rawText String             // 导入原文（供重新切分/排查）
  totalCount Int @default(0)
  autoPublish Boolean @default(true) // 直接发布（low 置信度与疑似重复仍强制待审）
  status String @default("parsing") // parsing | parsed | done
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions BankQuestion[]

  @@index([createdAt])
}
